# ========================================================
# HASTINA MOTOR PARTS (ALISONS GENERAL TRADING LLP)
# Production & Development Environment Configuration
# ========================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=hastina_user
POSTGRES_PASSWORD=hastina_secret_2026
POSTGRES_DB=hastina_db
DATABASE_URL="postgresql://hastina_user:hastina_secret_2026@localhost:5432/hastina_db?schema=public"

# --- Security & JWT ---
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# --- Search Engine (Meilisearch) ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=your-meilisearch-master-key-2026

# --- Email Notifications (Nodemailer / SMTP) ---
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@hastinamotorparts.com
SMTP_PASS=your-smtp-password
MAIL_FROM=sales@hastinamotorparts.com
SALES_NOTIFY_EMAIL=sales@hastinamotorparts.com

# --- Optional Cloudinary / S3 Storage ---
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# S3_BUCKET=hastina-parts-catalogue
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Bot Protection (Cloudflare Turnstile) ---
TURNSTILE_SECRET=0x4AAAAAA...

# --- Frontend Application (Next.js) ---
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=https://www.hastinamotorparts.com
NEXT_PUBLIC_WHATSAPP=919811000000
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
